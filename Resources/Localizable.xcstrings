    "Sniffing is app-managed. A provider that turns it off leaves connections dialed straight to an IP with no domain, so DOMAIN and GEOSITE rules can never match them." : {
      "localizations" : {
        "base" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sniffing is app-managed. A provider that turns it off leaves connections dialed straight to an IP with no domain, so DOMAIN and GEOSITE rules can never match them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嗅探由 ClashMax 管理。若订阅将其关闭，直接以 IP 发起的连接就不带域名，DOMAIN 与 GEOSITE 规则永远无法命中。"
          }
        }
      }
    },
    "Sniffing is on but no protocol is listed, so nothing would be sniffed. Add TLS, HTTP, or QUIC." : {
      "localizations" : {
        "base" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sniffing is on but no protocol is listed, so nothing would be sniffed. Add TLS, HTTP, or QUIC."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嗅探已开启但未列出任何协议，因此不会嗅探任何流量。请添加 TLS、HTTP 或 QUIC。"
          }
        }
      }
    },
